{
  "name": "survey-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "node tools/preview.mjs",
    "mock": "node tools/mock-submit.mjs",
    "test": "node tests/validate-check.mjs && node tests/preview-check.mjs && npm run test:lib && npm run test:flow",
    "validate": "node tools/validate.mjs",
    "test:live-baseline": "node tests/preview-check.mjs --live-baseline",
    "test:lib": "node --test tests/unit/*.test.mjs tests/collector/*.test.mjs tests/reports/*.test.mjs tests/deploy/*.test.mjs",
    "test:flow": "node tests/flow-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "wrangler": "^4.80.0"
  }
}
